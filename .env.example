APP_NAME="Midway Weather"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# In production set APP_DEBUG=false and APP_ENV=production.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite is the only supported database for this project.
# Leave DB_DATABASE unset to use the default database/database.sqlite file,
# or point it at an absolute path on the Raspberry Pi.
DB_CONNECTION=sqlite

# Lightweight drivers so the Raspberry Pi needs no extra daemons
# (no Redis, no separate queue worker). The file cache store still provides
# the atomic locks used for scheduler overlap protection.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log

# ---------------------------------------------------------------------------
# Midway Weather
# ---------------------------------------------------------------------------

# Ambient Weather REST API credentials. Create both keys on your account page:
#   https://ambientweather.net/account
# applicationKey identifies this app; apiKey grants read access to your devices.
# These values stay server-side only and must NEVER be committed or exposed to
# the browser. For a local demo, leave them blank and run weather:demo (see README).
AMBIENT_API_KEY=
AMBIENT_APPLICATION_KEY=
# The MAC address of the station whose lastData feeds the display, e.g. AA:BB:CC:DD:EE:FF
AMBIENT_DEVICE_MAC=

# Station + location metadata shown on the display.
WEATHER_STATION_NAME="Midway Weather"
WEATHER_LOCATION_NAME="Powder Springs, Georgia"

# Coordinates for the forecast request and map center. The defaults below point
# at the Powder Springs town center (public knowledge), NOT a private address.
# Use an approximate, privacy-conscious location rather than exact home coords.
WEATHER_LATITUDE=33.8595
WEATHER_LONGITUDE=-84.6769
WEATHER_TIMEZONE=America/New_York

# Static current-radar map. The browser loads one latest RainViewer frame and
# replaces it every 10 minutes; it never preloads or animates radar history.
WEATHER_RADAR_ENABLED=true
WEATHER_RADAR_ZOOM=8
WEATHER_RADAR_REFRESH_MINUTES=10
WEATHER_RADAR_OPACITY=0.65

# How many days of detailed observations to keep before cleanup prunes them.
WEATHER_OBSERVATION_RETENTION_DAYS=10

# Demo mode lets the dashboard render with generated fixture data before real
# Ambient credentials are configured. Keep this false (or unset) in production.
WEATHER_DEMO_MODE=false

# Weather admin: configure an email and password hash for this installation.
# Alternatively set WEATHER_ADMIN_CREDENTIALS_FILE to a private JSON sidecar.
MIDWAY_WEATHER_ADMIN_EMAIL=
MIDWAY_WEATHER_ADMIN_PASSWORD_HASH=
